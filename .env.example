# ===========================================
# Required
# ===========================================

# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — REQUIRED for in-app account deletion (Apple Guideline 5.1.1).
# Keep this server-side only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Optional
# ===========================================

# Google Maps Geocoding (falls back to Nominatim/OpenStreetMap if not set)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Resend — email notifications when sellers are contacted
# Sign up at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=TrashTrove <noreply@yourdomain.com>

# Site URL — canonical origin used for email links, OG images, and
# OAuth redirect URLs. MUST match where the web app is actually served,
# because the mobile app's Capacitor WebView loads the web app from this origin.
NEXT_PUBLIC_SITE_URL=https://trashtrove.xyz
